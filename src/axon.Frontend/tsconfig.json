{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "customConditions": ["source"],
    "paths": { "@/*": ["./src/*"] },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts", "vite.config.test.ts"]
}
